        {
          "name": "4.1 上传文件",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const fullPath = body && body.data && body.data.path;",
                  "if (fullPath) {",
                  "  const marker = '/projects/_default/';",
                  "  const index = fullPath.indexOf(marker);",
                  "  if (index >= 0) {",
                  "    pm.collectionVariables.set('filePath', fullPath.slice(index + marker.length));",
                  "  }",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "value": null
                },
                {
                  "key": "projectId",
                  "type": "text",
                  "value": "{{projectId}}",
                  "description": "项目 ID；留空默认 _default"
