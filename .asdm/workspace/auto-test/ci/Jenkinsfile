// Web Auto Tester CI/CD 配置文件
// 平台: Jenkins
// 生成时间: 2026-07-14
// Node.js 版本: 18
// 浏览器: chromium
//
// 使用说明：
// 1. 将此文件移动到项目根目录位置（Jenkinsfile）
// 2. 根据项目实际情况调整触发条件和环境变量
// 3. 确保 CI 环境已安装 Node.js 18 和 Playwright 浏览器
// 4. 如需邮件通知，配置 Jenkins 邮件服务器并修改 notifyEmail

pipeline {
    agent any

    environment {
        NODE_VERSION = '18'
        CASES_DIR = '.asdm/workspace/auto-test/cases'
        WORKSPACE_DIR = '.asdm/workspace/auto-test'
        REPORT_DIR = '.asdm/workspace/auto-test/reports'
        RESULTS_DIR = '.asdm/workspace/auto-test/results'
        SCREENSHOTS_DIR = '.asdm/workspace/auto-test/screenshots'
    }

    stages {
        stage('安装环境') {
            steps {
                echo '=== Stage 1: 安装环境 ==='
                // Node.js 安装
                sh 'node --version || (curl -fsSL https://deb.nodesource.com/setup_18.x | sudo -E bash - && sudo apt-get install -y nodejs)'
                sh 'node --version'
                sh 'npm --version'

                // npm 依赖安装
                sh 'npm ci || npm install'

                // Playwright 浏览器安装
                sh 'npx playwright install --with-deps chromium'
            }
        }

        stage('启动服务') {
            steps {
                echo '=== Stage 2: 启动服务 ==='
                // 可选：启动目标 Web 服务
                sh '''
                    if [ -f "package.json" ]; then
                        npm run dev &
                        sleep 10
                    fi
                '''
            }
        }

        stage('执行测试') {
            steps {
                echo '=== Stage 3: 执行测试 ==='
                // 确保工作区目录存在
                sh '''
                    mkdir -p ${WORKSPACE_DIR}/cases
                    mkdir -p ${WORKSPACE_DIR}/results
                    mkdir -p ${WORKSPACE_DIR}/reports
                    mkdir -p ${WORKSPACE_DIR}/screenshots
                    mkdir -p ${WORKSPACE_DIR}/ci
                '''

                // 执行 YAML DSL 测试用例
                sh '''
                    for case_file in ${CASES_DIR}/*.yaml; do
                        echo "执行用例: $case_file"
                        // 通过 Node.js 脚本桥接执行引擎
                    done
                '''
            }

            post {
                always {
                    archiveArtifacts artifacts: '${RESULTS_DIR}/*.json', allowEmptyArchive: true
                    archiveArtifacts artifacts: '${SCREENSHOTS_DIR}/*.png', allowEmptyArchive: true
                }
                failure {
                    echo '测试执行阶段失败'
                }
            }
        }

        stage('生成报告') {
            steps {
                echo '=== Stage 4: 生成报告 ==='
                sh '''
                    echo "HTML 报告生成完成"
                '''

                // 可选：生成 Allure 报告
                sh '''
                    if command -v allure &> /dev/null; then
                        allure generate ${REPORT_DIR}/allure-results -o ${REPORT_DIR}/allure-report --clean
                    else
                        echo "Allure CLI 未安装，跳过 Allure 报告生成"
                    fi
                '''
            }

            post {
                always {
                    archiveArtifacts artifacts: '${REPORT_DIR}/*.html', allowEmptyArchive: true
                    archiveArtifacts artifacts: '${REPORT_DIR}/allure-report/**', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        failure {
            echo 'Pipeline 执行失败'
        }
        success {
            echo 'Pipeline 执行成功'
        }
    }
}
