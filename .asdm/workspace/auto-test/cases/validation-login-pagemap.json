{
  "description": "登录页面 URL→选择器 映射文件（Phase 3 验证）",
  "mappings": {
    "/login": {
      "high": {
        "selectors": ["[data-testid='login-form']", "[data-testid='login-btn']", "[data-testid='username-input']"],
        "assertions": ["visible", "titleMatch"]
      },
      "medium": {
        "selectors": ["[data-testid='welcome-msg']"],
        "assertions": ["textMatch"]
      }
    },
    "/dashboard": {
      "high": {
        "selectors": ["[data-testid='dashboard-container']", "[data-testid='user-avatar']"],
        "assertions": ["visible"]
      },
      "medium": {
        "selectors": ["[data-testid='export-btn']"],
        "assertions": ["urlMatch"]
      }
    }
  }
}
