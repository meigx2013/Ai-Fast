# ============================================================
# 弈境 · 人机对弈后端 环境变量示例
# ============================================================
# 本项目运行时不自动加载 .env 文件，此文件仅作配置说明示例。
# 实际运行必须通过本机环境变量注入，示例值不得包含真实凭据。
#
# Windows PowerShell 示例（仅占位符）：
#   $env:DEEPSEEK_API_KEY = "<your-key-here>"
#   .venv\Scripts\python.exe -m uvicorn backend.main:app
# ============================================================

# DeepSeek API 密钥：必须留空；运行时从环境变量读取，禁止写入代码/日志/前端
DEEPSEEK_API_KEY=

# 模型标识，默认 deepseek-flash（服务端支持 deepseek-flash / deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-flash

# 模型服务地址（Chat Completions 风格接口）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 单次模型调用超时（秒），默认 12
DEEPSEEK_TIMEOUT_SECONDS=12

# 模型调用失败后的最大重试次数，默认 1
DEEPSEEK_MAX_RETRIES=1

# 模型重试之间的退避间隔（秒），默认 0.5
DEEPSEEK_RETRY_BACKOFF_SECONDS=0.5

# 模型单次响应 max_tokens 上限，默认 512（避免无界响应）
DEEPSEEK_MAX_TOKENS=512

# 启发式候选点 Top-K 默认值，随级位在后端内调整，默认 30
AI_CANDIDATE_TOP_K=30

# 允许的棋盘尺寸，逗号分隔，默认 9,13,19
ALLOWED_BOARD_SIZES=9,13,19

# 开发期 CORS 允许的本地前端源，逗号分隔；设为 "none" 可禁用 CORS
# 默认仅允许本地静态服务器常见端口（生产模式为同源访问，无需 CORS）
CORS_ALLOW_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
